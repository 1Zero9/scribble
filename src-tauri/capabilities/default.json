{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The smallest set of permissions Scribble needs. Nothing here allows shell execution, arbitrary file-system access outside Scribble's own application-data folder, or any network capability.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-unminimize",
    "core:app:allow-version",
    "core:path:default",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/assets" },
        { "path": "$APPDATA/assets/**" }
      ],
      "deny": [{ "path": "$APPDATA/scribble.db" }]
    },
    "fs:allow-app-meta-recursive",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",

    "dialog:allow-open",
    "dialog:allow-save",

    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",

    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
